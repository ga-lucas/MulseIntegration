# Copy to .env.mulse and replace all password/secret placeholders with distinct values.
MULSE_OIDC_AUTHORITY=http://mulse-auth.test:8180/realms/mulse
MULSE_UI_CLIENT_SECRET=replace-this-ui-client-secret
MULSE_API_CLIENT_SECRET=replace-this-api-client-secret
MULSE_TLS_PASSWORD=replace-this-pfx-password
MULSE_KEYCLOAK_DB_PASSWORD=replace-this-database-password
MULSE_KEYCLOAK_ADMIN_PASSWORD=replace-this-bootstrap-password
MULSE_KEYCLOAK_USER_PASSWORD=replace-this-mulse-login-password

# Optional overrides:
# MULSE_HTTPS_PORT=7443
# MULSE_KEYCLOAK_PORT=8180
# MULSE_TLS_CERT=./.mulse-compose/mulse.pfx
# MULSE_PLUGIN_DIR=./.mulse-compose/plugins
