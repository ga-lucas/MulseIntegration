@inject IServiceProvider Services

<details>
    <summary>Test native control flow with mocks</summary>
    Waiting or receiving suspends and ends this one-shot test unless wait advancing is enabled; receives cannot be resumed.
    <label class="field-label">Input name <input class="mapping-input" @bind="_name" @bind:after="Invalidate" /></label>
    <label class="field-label">Input content type <input class="mapping-input" @bind="_contentType" @bind:after="Invalidate" /></label>
    <label class="field-label">Synthetic input text <textarea class="mapping-input" @bind="_content" @bind:after="Invalidate"></textarea></label>
    <label class="field-label"><input type="checkbox" @bind="_advanceWaits" @bind:after="Invalidate" /> Advance a virtual clock past Wait nodes and resume (no real delay; Receive nodes still stop the test)</label>
    <h4>Input metadata</h4>
    @foreach (var entry in _metadata)
    {
        <div @key="entry">
            <label class="field-label">Key <input class="mapping-input" @bind="entry.Key" @bind:after="Invalidate" /></label>
            <label class="field-label">Value <input class="mapping-input" @bind="entry.Value" @bind:after="Invalidate" /></label>
            <button type="button" class="secondary-button" @onclick="() => RemoveMetadata(entry)">Remove metadata</button>
        </div>
    }
    <button type="button" class="secondary-button" @onclick="AddMetadata">Add metadata</button>
    <h4>Mock module responses</h4>
    @foreach (var mock in _mocks)
    {
        <fieldset @key="mock"><legend>@mock.Kind: @mock.Module</legend>
            @if (mock.Manual)
            {
                <label class="field-label">Kind <select @bind="mock.Kind" @bind:after="Invalidate"><option>Augment</option><option>Render</option><option>Deliver</option><option>Transform</option></select></label>
                <label class="field-label">Module ID <input class="mapping-input" @bind="mock.Module" @bind:after="Invalidate" /></label>
                <button type="button" class="secondary-button" @onclick="() => RemoveMock(mock)">Remove mock</button>
            }
            <label class="field-label"><input type="checkbox" @bind="mock.Enabled" @bind:after="Invalidate" /> Supply explicit mock</label>
            @if (mock.Enabled)
            {
                @if (mock.Kind == "Deliver") { <label class="field-label"><input type="checkbox" @bind="mock.HasOutput" @bind:after="Invalidate" /> Return a response payload</label> }
                @if (mock.Kind != "Deliver" || mock.HasOutput)
                {
                    <label class="field-label">Output name <input class="mapping-input" @bind="mock.Name" @bind:after="Invalidate" /></label>
                    <label class="field-label">Output content type <input class="mapping-input" @bind="mock.ContentType" @bind:after="Invalidate" /></label>
                    <label class="field-label">Output text <textarea class="mapping-input" @bind="mock.Content" @bind:after="Invalidate"></textarea></label>
                    <label class="field-label"><input type="checkbox" @bind="mock.UseCustomMetadata" @bind:after="Invalidate" /> Set output metadata independently</label>
                    @if (mock.UseCustomMetadata)
                    {
                        @foreach (var entry in mock.Metadata)
                        {
                            <div @key="entry">
                                <label class="field-label">Output metadata key <input class="mapping-input" @bind="entry.Key" @bind:after="Invalidate" /></label>
                                <label class="field-label">Output metadata value <input class="mapping-input" @bind="entry.Value" @bind:after="Invalidate" /></label>
                                <button type="button" class="secondary-button" @onclick="() => RemoveOutputMetadata(mock, entry)">Remove output metadata</button>
                            </div>
                        }
                        <button type="button" class="secondary-button" @onclick="() => AddOutputMetadata(mock)">Add output metadata</button>
                    }
                    else { <p class="field-hint">The output uses the synthetic input metadata.</p> }
                }
            }
        </fieldset>
    }
    <button type="button" class="secondary-button" @onclick="AddMock">Add mock for dynamic module</button>
    <button type="button" class="secondary-button" disabled="@_running" @onclick="RunAsync">Run isolated test</button>
    @if (_error is not null) { <p class="status-banner error" role="alert">@_error</p> }
    @if (_result is not null)
    {
        <p>Test status: @_result.Status @(_result.SuspensionReason)</p>
        @if (_result.WaitResumes > 0) { <p>Waits resumed on a virtual clock: @_result.WaitResumes</p> }
        <h4>Mock calls</h4>
        @foreach (var call in _result.Calls)
        {
            <p>@call.Kind: @call.Module</p>
            @foreach (var payload in call.Input)
            {
                <p>@payload.Name (@payload.ContentType)</p><pre>@payload.Content</pre>
                <ul>@foreach (var pair in payload.Metadata) { <li>@pair.Key: @pair.Value</li> }</ul>
            }
        }
        <h4>Output</h4>
        @foreach (var payload in _result.Output)
        {
            <p>@payload.Name (@payload.ContentType)</p><pre>@payload.Content</pre>
            <ul>@foreach (var pair in payload.Metadata) { <li>@pair.Key: @pair.Value</li> }</ul>
        }
        <h4>Replies</h4>
        @foreach (var payload in _result.Replies)
        {
            <p>@payload.Name (@payload.ContentType)</p><pre>@payload.Content</pre>
            <ul>@foreach (var pair in payload.Metadata) { <li>@pair.Key: @pair.Value</li> }</ul>
        }
    }
    <h4>Compare with real output</h4>
    <p class="field-hint">Paste output captured from the real server for an input. Mulse runs this same isolated test (same mocks) and compares what the chosen delivery receives with your sample, then classifies each difference. A match means the supplied samples match; it does not show the flows are equivalent. Samples can contain real data: they are compared on this server, not stored and never sent to AI.</p>
    @foreach (var sample in _samples)
    {
        <fieldset @key="sample"><legend>Sample: @sample.Name</legend>
            <label class="field-label">Sample name <input class="mapping-input" @bind="sample.Name" @bind:after="ClearComparison" /></label>
            <label class="field-label">Input text (leave empty to use the synthetic input above) <textarea class="mapping-input" @bind="sample.Input" @bind:after="ClearComparison"></textarea></label>
            <label class="field-label">Compare the input of delivery
                <select @bind="sample.Delivery" @bind:after="ClearComparison">
                    <option value="">The last delivery, or the output if nothing is delivered</option>
                    @foreach (var module in DeliveryModules) { <option value="@module">@module</option> }
                </select>
            </label>
            <label class="field-label">Expected real output <textarea class="mapping-input" @bind="sample.Expected" @bind:after="ClearComparison"></textarea></label>
            <button type="button" class="secondary-button" @onclick="() => RemoveSample(sample)">Remove sample</button>
        </fieldset>
    }
    <button type="button" class="secondary-button" @onclick="AddSample">Add real-output sample</button>
    <button type="button" class="secondary-button" disabled="@(_comparing || _samples.Count == 0)" @onclick="CompareAsync">Compare with real output</button>
    @if (_compareError is not null) { <p class="status-banner error" role="alert">@_compareError</p> }
    @if (_comparison is not null)
    {
        <p class="compare-summary">@_comparison.Summary.Statement</p>
        @foreach (var item in _comparison.Results)
        {
            <h5>@item.Name: @VerdictText(item.Verdict)</h5>
            @if (item.Error is not null) { <p class="status-banner error" role="alert">@item.Error</p> }
            @if (item.Differences.Count > 0)
            {
                <table class="compare-differences">
                    <thead><tr><th>Difference</th><th>Where</th><th>Expected (real)</th><th>Mulse</th><th>Effect</th></tr></thead>
                    <tbody>
                    @foreach (var difference in item.Differences)
                    {
                        <tr title="@difference.Explanation">
                            <td>@difference.Class</td><td>@difference.Path</td><td><code>@difference.Expected</code></td><td><code>@difference.Actual</code></td>
                            <td>@(difference.Cosmetic ? "Formatting only" : "Changes content")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                @if (item.Truncated) { <p class="field-hint">More differences exist than are shown.</p> }
            }
        }
        <CompareExplainPanel Results="_comparison.Results" Consent="_explainConsent" />
    }
    <h4>Saved scenarios</h4>
    <p class="field-hint">Keep the samples above to run again after you change the definition. Scenarios are stored encrypted on the Mulse server, apart from flows, exports and backups, and are never sent to AI. The definition itself is not saved. A scenario can contain real data, so choose how long to keep it and delete it when you no longer need it. Running a saved scenario uses the input, mocks and samples as they were saved; Load copies its samples here to edit, and uses the test setup above.</p>
    <label class="field-label">Scenario name <input class="mapping-input" @bind="_scenarioName" maxlength="80" data-testid="scenario-name" /></label>
    <label class="field-label">Keep for
        <select @bind="_scenarioRetention" data-testid="scenario-retention">
            <option value="">Until I delete it</option>
            <option value="1">1 day</option>
            <option value="7">7 days</option>
            <option value="30">30 days</option>
            <option value="90">90 days</option>
            <option value="365">365 days</option>
        </select>
    </label>
    <label class="field-label"><input type="checkbox" @bind="_scenarioRealData" data-testid="scenario-real-data" /> These samples contain real data</label>
    <label class="field-label">Saved by (used when the server does not know who you are) <input class="mapping-input" @bind="_scenarioSavedBy" maxlength="80" data-testid="scenario-saved-by" /></label>
    <button type="button" class="secondary-button" disabled="@(_scenarioBusy || _samples.Count == 0)" @onclick="SaveScenarioAsync" data-testid="scenario-save">Save as scenario</button>
    <button type="button" class="secondary-button" disabled="@_scenarioBusy" @onclick="RefreshScenariosAsync" data-testid="scenario-refresh">Show saved scenarios</button>
    @if (_scenarioError is not null) { <p class="status-banner error" role="alert" data-testid="scenario-error">@_scenarioError</p> }
    @if (_scenarioNotice is not null) { <p class="field-hint" role="status" data-testid="scenario-notice">@_scenarioNotice</p> }
    @if (_scenarios is not null)
    {
        @if (_scenarios.Count == 0) { <p class="field-hint" data-testid="scenario-empty">No scenarios are saved.</p> }
        else
        {
            <table class="compare-differences" data-testid="scenario-list">
                <thead><tr><th>Scenario</th><th>Samples</th><th>Saved</th><th>Expires</th><th>Last run</th><th></th></tr></thead>
                <tbody>
                @foreach (var scenario in _scenarios)
                {
                    <tr @key="scenario.Id">
                        <td>@scenario.Name @if (scenario.ContainsRealData) { <strong title="Contains real data">(real data)</strong> }</td>
                        <td>@scenario.SampleCount</td>
                        <td>@scenario.SavedBy, @Stamp(scenario.SavedAtUtc)</td>
                        <td>@(scenario.ExpiresAtUtc is { } expires ? Stamp(expires) : "Until deleted")</td>
                        <td>@(scenario.LastRunStatement ?? "Not run yet")</td>
                        <td>
                            <button type="button" class="secondary-button" disabled="@_scenarioBusy" @onclick="() => RunScenarioAsync(scenario)" data-testid="scenario-run">Run</button>
                            <button type="button" class="secondary-button" disabled="@_scenarioBusy" @onclick="() => LoadScenarioAsync(scenario)" data-testid="scenario-load">Load</button>
                            @if (_confirmDeleteId == scenario.Id)
                            {
                                <button type="button" class="secondary-button" disabled="@_scenarioBusy" @onclick="() => DeleteScenarioAsync(scenario)" data-testid="scenario-delete-confirm">Confirm delete</button>
                                <button type="button" class="secondary-button" @onclick="() => _confirmDeleteId = null">Keep</button>
                            }
                            else
                            {
                                <button type="button" class="secondary-button" disabled="@_scenarioBusy" @onclick="() => _confirmDeleteId = scenario.Id" data-testid="scenario-delete">Delete</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
</details>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public List<NativeFlowNodeViewModel> Nodes { get; set; } = [];
    private string _name = "sample.xml", _contentType = "application/xml", _content = "", _definition = "";
    private readonly List<MetadataEntry> _metadata = [new() { Key = "group", Value = "test" }, new() { Key = "messageId", Value = "1" }, new() { Key = "channel", Value = "input" }];
    private readonly List<MockEntry> _mocks = [];
    private NativeFlowTestResponseViewModel? _result;
    private string? _error;
    private bool _running;
    private bool _advanceWaits;
    private int _revision;
    private int _comparisonRevision;
    private readonly List<SampleEntry> _samples = [];
    private NativeFlowCompareResponseViewModel? _comparison;
    private string? _compareError;
    private bool _comparing;
    private string _scenarioName = "", _scenarioRetention = "", _scenarioSavedBy = "";
    private bool _scenarioRealData = true, _scenarioBusy;
    private string? _scenarioError, _scenarioNotice, _confirmDeleteId;
    private IReadOnlyList<ComparisonScenarioSummaryViewModel>? _scenarios;
    private readonly BizTalkAssistConsent _explainConsent = new();
    protected override void OnParametersSet()
    {
        if (_definition == Value) return;
        _definition = Value; Invalidate();
        var choices = All(Nodes).Where(node => node.Kind is "Augment" or "Render" or "Deliver" or "InvokeTransform")
            .Where(node => !string.IsNullOrWhiteSpace(node.Module)).Select(node => (Kind: node.Kind == "InvokeTransform" ? "Transform" : node.Kind, node.Module)).Distinct().ToArray();
        _mocks.RemoveAll(mock => !mock.Manual && !choices.Contains((mock.Kind, mock.Module)));
        foreach (var choice in choices)
            if (!_mocks.Any(mock => mock.Kind == choice.Kind && mock.Module == choice.Module)) _mocks.Add(new() { Kind = choice.Kind, Module = choice.Module });
    }
    private static IEnumerable<NativeFlowNodeViewModel> All(IEnumerable<NativeFlowNodeViewModel> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in All(node.Children)) yield return child;
            foreach (var child in All(node.Otherwise)) yield return child;
        }
    }
    private IEnumerable<string> DeliveryModules => _mocks.Where(mock => mock.Kind == "Deliver" && !string.IsNullOrWhiteSpace(mock.Module)).Select(mock => mock.Module).Distinct();
    private void Invalidate() { _revision++; _result = null; _error = null; ClearComparison(); }
    private void ClearComparison() { _comparisonRevision++; _comparison = null; _compareError = null; }
    private void AddSample() { _samples.Add(new() { Name = "sample " + (_samples.Count + 1) }); ClearComparison(); }
    private void RemoveSample(SampleEntry sample) { _samples.Remove(sample); ClearComparison(); }
    private static string VerdictText(string verdict) => verdict switch
    {
        "Identical" => "identical",
        "FormattingOnly" => "matches apart from formatting",
        "Different" => "differs",
        _ => "not compared"
    };
    private async Task CompareAsync()
    {
        _comparison = null; _compareError = null;
        if (Services.GetService(typeof(IMulseApiClient)) is not IMulseApiClient api) { _compareError = "The comparison API is unavailable."; return; }
        var pairs = BuildPairs(out var problem);
        if (pairs is null) { _compareError = problem; return; }
        var revision = _comparisonRevision; _comparing = true;
        try
        {
            var result = await api.CompareNativeFlowAsync(new(Value, pairs, _advanceWaits), default);
            if (revision == _comparisonRevision) _comparison = result;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or NotSupportedException)
        { if (revision == _comparisonRevision) _compareError = exception.Message; }
        finally { _comparing = false; }
    }
    private List<NativeFlowComparePairViewModel>? BuildPairs(out string? problem)
    {
        problem = null;
        if (_samples.Count == 0) { problem = "Add at least one real-output sample."; return null; }
        if (_samples.Any(sample => string.IsNullOrWhiteSpace(sample.Name)) || _samples.Select(sample => sample.Name.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _samples.Count)
        { problem = "Sample names must be nonempty and unique."; return null; }
        if (_samples.Any(sample => string.IsNullOrEmpty(sample.Expected))) { problem = "Every sample needs the expected real output."; return null; }
        if (!ValidMetadata(_metadata) || _mocks.Any(mock => mock.Enabled && (mock.Kind != "Deliver" || mock.HasOutput) && mock.UseCustomMetadata && !ValidMetadata(mock.Metadata)))
        { problem = "Input and mock output metadata keys must be nonempty and unique."; return null; }
        var metadata = _metadata.ToDictionary(entry => entry.Key, entry => entry.Value, StringComparer.Ordinal);
        var mocks = _mocks.Where(mock => mock.Enabled).Select(mock => new NativeFlowTestMockViewModel(mock.Kind, mock.Module,
            mock.Kind == "Deliver" && !mock.HasOutput ? null : new(mock.Name, mock.Content, mock.ContentType,
                mock.UseCustomMetadata ? mock.Metadata.ToDictionary(entry => entry.Key, entry => entry.Value, StringComparer.Ordinal) : metadata))).ToList();
        return _samples.Select(sample => new NativeFlowComparePairViewModel(sample.Name.Trim(), sample.Expected,
            new(_name, string.IsNullOrEmpty(sample.Input) ? _content : sample.Input, _contentType, metadata), mocks,
            string.IsNullOrEmpty(sample.Delivery) ? null : sample.Delivery)).ToList();
    }
    private static string Stamp(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture);
    private IMulseApiClient? ScenarioApi()
    {
        if (Services.GetService(typeof(IMulseApiClient)) is IMulseApiClient api) return api;
        _scenarioError = "The scenario API is unavailable.";
        return null;
    }
    private async Task ScenarioActionAsync(Func<IMulseApiClient, Task> action)
    {
        _scenarioError = null; _scenarioNotice = null;
        if (ScenarioApi() is not { } api) return;
        _scenarioBusy = true;
        try { await action(api); }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or NotSupportedException)
        { _scenarioError = exception.Message; }
        finally { _scenarioBusy = false; }
    }
    private Task RefreshScenariosAsync() => ScenarioActionAsync(async api => _scenarios = await api.ListComparisonScenariosAsync(default));
    private Task SaveScenarioAsync() => ScenarioActionAsync(async api =>
    {
        var pairs = BuildPairs(out var problem);
        if (pairs is null) { _scenarioError = problem; return; }
        int? retention = int.TryParse(_scenarioRetention, out var days) ? days : null;
        var saved = await api.SaveComparisonScenarioAsync(new(_scenarioName.Trim(), pairs, _advanceWaits, _scenarioRealData, retention,
            string.IsNullOrWhiteSpace(_scenarioSavedBy) ? null : _scenarioSavedBy.Trim()), default);
        _scenarios = await api.ListComparisonScenariosAsync(default);
        _scenarioNotice = $"Saved '{saved.Name}'. {(saved.ExpiresAtUtc is { } expires ? $"It will be deleted after {Stamp(expires)}." : "It is kept until you delete it.")}";
    });
    private Task RunScenarioAsync(ComparisonScenarioSummaryViewModel scenario) => ScenarioActionAsync(async api =>
    {
        if (string.IsNullOrWhiteSpace(Value)) { _scenarioError = "There is no native definition to run the scenario against."; return; }
        _comparison = null; _compareError = null; _comparisonRevision++;
        _comparison = await api.RunComparisonScenarioAsync(scenario.Id, Value, default);
        _scenarios = await api.ListComparisonScenariosAsync(default);
        _scenarioNotice = $"Ran '{scenario.Name}'. The results are shown above; only the verdicts, difference classes and paths are kept, never the values.";
    });
    private Task LoadScenarioAsync(ComparisonScenarioSummaryViewModel scenario) => ScenarioActionAsync(async api =>
    {
        var loaded = await api.GetComparisonScenarioAsync(scenario.Id, default);
        _samples.Clear();
        foreach (var pair in loaded.Pairs)
            _samples.Add(new() { Name = pair.Name, Input = pair.Input?.Content ?? "", Delivery = pair.DeliverModule ?? "", Expected = pair.Expected });
        _advanceWaits = loaded.AdvanceWaits;
        _scenarioName = loaded.Name; _scenarioRealData = loaded.ContainsRealData;
        ClearComparison();
        _scenarioNotice = $"Loaded the samples of '{loaded.Name}'. Saving under the same name replaces it.";
    });
    private Task DeleteScenarioAsync(ComparisonScenarioSummaryViewModel scenario) => ScenarioActionAsync(async api =>
    {
        _confirmDeleteId = null;
        await api.DeleteComparisonScenarioAsync(scenario.Id, default);
        _scenarios = await api.ListComparisonScenariosAsync(default);
        _scenarioNotice = $"Deleted '{scenario.Name}'.";
    });
    private void AddMetadata() { _metadata.Add(new()); Invalidate(); }
    private void RemoveMetadata(MetadataEntry entry) { _metadata.Remove(entry); Invalidate(); }
    private void AddMock() { _mocks.Add(new() { Manual = true, Kind = "Render" }); Invalidate(); }
    private void RemoveMock(MockEntry mock) { _mocks.Remove(mock); Invalidate(); }
    private void AddOutputMetadata(MockEntry mock) { mock.Metadata.Add(new()); Invalidate(); }
    private void RemoveOutputMetadata(MockEntry mock, MetadataEntry entry) { mock.Metadata.Remove(entry); Invalidate(); }
    private static bool ValidMetadata(List<MetadataEntry> entries) => entries.All(entry => !string.IsNullOrWhiteSpace(entry.Key))
        && entries.Select(entry => entry.Key).Distinct(StringComparer.Ordinal).Count() == entries.Count;
    private async Task RunAsync()
    {
        _result = null; _error = null;
        if (Services.GetService(typeof(IMulseApiClient)) is not IMulseApiClient api) { _error = "Native test API is unavailable."; return; }
        if (!ValidMetadata(_metadata) || _mocks.Any(mock => mock.Enabled && (mock.Kind != "Deliver" || mock.HasOutput) && mock.UseCustomMetadata && !ValidMetadata(mock.Metadata)))
        { _error = "Input and mock output metadata keys must be nonempty and unique."; return; }
        var metadata = _metadata.ToDictionary(entry => entry.Key, entry => entry.Value, StringComparer.Ordinal);
        var input = new NativeFlowTestPayloadViewModel(_name, _content, _contentType, metadata);
        var mocks = _mocks.Where(mock => mock.Enabled).Select(mock => new NativeFlowTestMockViewModel(mock.Kind, mock.Module,
            mock.Kind == "Deliver" && !mock.HasOutput ? null : new(mock.Name, mock.Content, mock.ContentType,
                mock.UseCustomMetadata ? mock.Metadata.ToDictionary(entry => entry.Key, entry => entry.Value, StringComparer.Ordinal) : metadata))).ToList();
        var revision = _revision; _running = true;
        try
        {
            var result = await api.TestNativeFlowAsync(new(Value, input, mocks, _advanceWaits), default);
            if (revision == _revision) _result = result;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or NotSupportedException)
        { if (revision == _revision) _error = exception.Message; }
        finally { _running = false; }
    }
    private sealed class SampleEntry { public string Name { get; set; } = ""; public string Input { get; set; } = ""; public string Delivery { get; set; } = ""; public string Expected { get; set; } = ""; }
    private sealed class MetadataEntry { public string Key { get; set; } = ""; public string Value { get; set; } = ""; }
    private sealed class MockEntry
    {
        public string Kind { get; set; } = ""; public string Module { get; set; } = ""; public bool Enabled { get; set; } public bool Manual { get; set; }
        public bool HasOutput { get; set; } public string Name { get; set; } = "mock.xml"; public string ContentType { get; set; } = "application/xml"; public string Content { get; set; } = "";
        public bool UseCustomMetadata { get; set; } public List<MetadataEntry> Metadata { get; } = [];
    }
}
