@using Mulse.Ui.Models
@using Mulse.Ui.Services
@inject IMulseApiClient Api

<section class="real-sample-handoff" aria-label="Use the recorded samples to check the migrated flow" data-testid="real-sample-handoff">
    <h4>Check the migrated flow against these samples</h4>
    <p class="field-hint">
        Name each pair <code>name.in.xml</code> and <code>name.out.xml</code> (or put them in folders called <code>in</code> and <code>out</code>), and upload them together as a zip.
        The pairs are saved as a comparison scenario. Open the flow's native test panel, choose "Show saved scenarios" and press Run to see classified differences.
        Nothing here is sent to an AI provider.
    </p>
    <div class="action-row">
        <button class="secondary-button" disabled="@(_busy || !HasSamples)" @onclick="Check" data-testid="handoff-check">Check the pairs</button>
        @if (!HasSamples)
        {
            <span class="field-hint">Add a real input and output sample above first.</span>
        }
    </div>

    @if (_result is not null)
    {
        <p data-testid="handoff-found">@_result.Samples.Count pair(s) found.</p>
        @if (_result.Samples.Count > 0)
        {
            <ul class="field-hint" data-testid="handoff-pairs">
                @foreach (var sample in _result.Samples)
                {
                    <li>@sample.Name</li>
                }
            </ul>
        }
        @if (_result.Problems.Count > 0)
        {
            <details open>
                <summary>@_result.Problems.Count file(s) were not used</summary>
                <ul data-testid="handoff-problems">
                    @foreach (var problem in _result.Problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            </details>
        }

        @if (_result.Samples.Count > 0)
        {
            <label class="field-label">Scenario name <input class="mapping-input" @bind="_name" maxlength="80" data-testid="handoff-name" /></label>
            <label class="field-label">
                Keep it
                <select @bind="_retention" data-testid="handoff-retention">
                    <option value="">Until I delete it</option>
                    <option value="1">1 day</option>
                    <option value="7">7 days</option>
                    <option value="30">30 days</option>
                    <option value="90">90 days</option>
                    <option value="365">365 days</option>
                </select>
            </label>
            <label class="field-label"><input type="checkbox" @bind="_realData" data-testid="handoff-real-data" /> These samples contain real data</label>
            <p class="field-hint">Scenarios are stored encrypted on the Mulse service machine, are left out of backups and exports, and expire as chosen.</p>
            <button class="run-button" disabled="@_busy" @onclick="SaveAsync" data-testid="handoff-save">@(_busy ? "Saving..." : "Save as a comparison scenario")</button>
        }
    }

    @if (_notice is not null)
    {
        <p class="field-hint" role="status" data-testid="handoff-notice">@_notice</p>
    }
    @if (_error is not null)
    {
        <p class="error-text" role="alert" data-testid="handoff-error">@_error</p>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<BizTalkSessionEvidence> Evidence { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, BizTalkEvidenceContent> Content { get; set; } = new Dictionary<string, BizTalkEvidenceContent>();
    [Parameter] public string SuggestedName { get; set; } = "import samples";

    private BizTalkRealSampleResult? _result;
    private string _name = "";
    private string _retention = "30";
    private bool _realData = true;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private bool HasSamples => Evidence.Any(e => e.Kind == BizTalkEvidenceKinds.RealOutput);

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_name)) _name = SuggestedName;
    }

    private void Check()
    {
        _error = null;
        _notice = null;
        _result = BizTalkRealSamplePairing.Pair(Evidence, Content);
    }

    private async Task SaveAsync()
    {
        if (_result is null || _result.Samples.Count == 0) return;
        _error = null;
        _notice = null;
        _busy = true;
        try
        {
            var pairs = _result.Samples.Select(sample => new NativeFlowComparePairViewModel(sample.Name, sample.Expected,
                new(sample.InputName, sample.Input, BizTalkRealSamplePairing.ContentTypeOf(sample.Input), new Dictionary<string, string>()), [])).ToList();
            int? days = int.TryParse(_retention, out var value) ? value : null;
            var saved = await Api.SaveComparisonScenarioAsync(new(_name.Trim(), pairs, false, _realData, days, null), default);
            _notice = $"Saved '{saved.Name}' with {saved.SampleCount} pair(s). {(saved.ExpiresAtUtc is { } expires ? $"It will be deleted after {expires.UtcDateTime:yyyy-MM-dd HH:mm} UTC." : "It is kept until you delete it.")} Open the flow's native test panel to run it.";
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or NotSupportedException)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
