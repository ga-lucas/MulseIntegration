@inject IServiceProvider Services

<details data-testid="explain-panel">
    <summary>Explain this flow</summary>
    <p class="field-hint">Plain-language facts read from the definition and the installed modules. This works on the Mulse server only: no AI provider is used and nothing is sent anywhere. Setting values are never shown, only whether each one is set.</p>
    <button type="button" class="secondary-button" disabled="@_busy" @onclick="ExplainFlowAsync" data-testid="explain-flow">Explain the flow</button>
    @if (_error is not null) { <p class="status-banner error" role="alert" data-testid="explain-error">@_error</p> }
    @if (_flow is not null)
    {
        <p data-testid="explain-summary">@_flow.NodeCount step(s)@(_flow.Durable ? ", durable (state is kept while it waits)" : ", not durable"): @string.Join(", ", _flow.KindCounts.Select(pair => $"{pair.Value} {pair.Key}"))</p>
        @if (_flow.Findings.Count == 0) { <p class="field-hint" data-testid="explain-no-findings">Nothing to point out.</p> }
        else
        {
            <h4>Worth a look</h4>
            <ul data-testid="explain-findings">
                @foreach (var finding in _flow.Findings)
                {
                    <li>@finding.Severity: @finding.Text @if (finding.NodeId is not null) { <button type="button" class="secondary-button" disabled="@_busy" @onclick="() => ExplainNodeAsync(finding.NodeId)">Show step</button> }</li>
                }
            </ul>
        }
        @if (_flow.MissingModules is { Count: > 0 })
        {
            <h4>Modules this server does not have</h4>
            <p class="field-hint">The flow uses these modules, but none is installed here. Check Modules > Module Packages first: a package that is registered but not loaded may already contain it. Otherwise you can copy a prompt that asks an AI tool to write it. The prompt names the module and the setting names the flow gives it. It never includes setting values, expressions or messages. Describe what the module should do; the more you say, the better the result.</p>
            <ul data-testid="explain-missing">
                @foreach (var missing in _flow.MissingModules)
                {
                    <li @key="missing.Module">
                        <strong>@missing.Module</strong> <span class="field-hint">(@missing.Kind, used by @missing.NodeIds.Count step(s))</span>
                        <button type="button" class="secondary-button" disabled="@_busy" @onclick="() => ChooseModule(missing.Module)" data-testid="module-prompt-choose">Prepare a prompt</button>
                    </li>
                }
            </ul>
        }
        @if (_flow.Effects.Count > 0)
        {
            <h4>What it sends</h4>
            <ul data-testid="explain-effects">@foreach (var effect in _flow.Effects) { <li>@effect</li> }</ul>
        }
        @if (_flow.ConfigReferences is { Count: > 0 })
        {
            <h4>Config values and secrets it refers to</h4>
            <p class="field-hint">Names only. Make sure each one exists in this environment before enabling the flow. Values are never shown.</p>
            <ul data-testid="explain-references">
                @foreach (var reference in _flow.ConfigReferences)
                {
                    <li @key="@(reference.Kind + reference.Name)"><strong>@reference.Name</strong> <span class="field-hint">(@reference.Kind, used by @reference.NodeIds.Count step(s))</span></li>
                }
            </ul>
        }
        <h4>Steps</h4>
        <ol data-testid="explain-steps" style="list-style:none;padding-left:0">
            @foreach (var step in _flow.Steps)
            {
                <li @key="step.Id" style="@($"margin-left:{step.Depth * 1.25}rem")">
                    <strong>@step.Title</strong> <span class="field-hint">(@step.Kind@(step.ModuleName is not null ? ", " + step.ModuleName : ""))</span>
                    <button type="button" class="secondary-button" disabled="@_busy" @onclick="() => ExplainNodeAsync(step.Id)" data-testid="explain-step">Explain</button>
                    @foreach (var note in step.Notes) { <div class="field-hint">@note</div> }
                </li>
            }
        </ol>
        <p class="field-hint" data-testid="explain-disclaimer">@_flow.Disclaimer</p>
    }
    @if (_node is not null)
    {
        <div data-testid="explain-node">
            <h4>@_node.Step.Title (@_node.KindInfo.Title)</h4>
            @foreach (var fact in _node.Facts) { <p>@fact</p> }
            @if (_node.ModuleDescription is not null) { <p>Module: @_node.ModuleDescription</p> }
            @if (_node.Settings.Count > 0)
            {
                <table class="compare-differences" data-testid="explain-settings">
                    <thead><tr><th>Setting</th><th>Required</th><th>State</th></tr></thead>
                    <tbody>
                    @foreach (var setting in _node.Settings)
                    {
                        <tr title="@setting.Description"><td>@setting.Label</td><td>@(setting.Required ? "Yes" : "No")</td><td>@setting.State</td></tr>
                    }
                    </tbody>
                </table>
            }
            @foreach (var finding in _node.Findings) { <p class="field-hint">@finding.Severity: @finding.Text</p> }
        </div>
    }
    @if (_promptModule is not null)
    {
        <div data-testid="module-prompt">
            <h4>Prompt for the module '@_promptModule'</h4>
            <label class="field-label">What should this module do? (optional; sent nowhere, it only goes into the prompt below)
                <textarea class="mapping-input" rows="4" maxlength="4000" @bind="_moduleDescription" data-testid="module-prompt-description"></textarea>
            </label>
            <button type="button" class="secondary-button" disabled="@_busy" @onclick="BuildPromptAsync" data-testid="module-prompt-build">Build the prompt</button>
            @if (_prompt is not null)
            {
                <p class="field-hint">Copy this into Copilot, ChatGPT or any assistant. @(_prompt.UnloadedPackages.Count > 0 ? $"Registered but not loaded packages that might already contain it: {string.Join(", ", _prompt.UnloadedPackages)}. " : "")It lists @_prompt.SettingKeys.Count setting name(s) and no values.</p>
                <textarea class="sample-textarea" readonly rows="14" aria-label="AI prompt for the module" value="@_prompt.Prompt" data-testid="module-prompt-text"></textarea>
                <p class="field-hint" data-testid="module-prompt-disclaimer">@_prompt.Disclaimer</p>
            }
        </div>
    }
    <div data-testid="wording-panel">
        <h4>Put it in plain words with AI</h4>
        <p class="field-hint">Optional. AI can describe the flow in plain words and answer a question about it. It is only sent the shape of the flow: step kinds and plain names, module ids, setting names with whether each is set, retry numbers and the names of config values and secrets. It never sees setting values, conditions, expressions, messages or secrets. You see exactly what would be sent first. The wording is a suggestion and changes nothing.</p>
        <label class="field-label">Question (optional)
            <input class="mapping-input" @bind="_wordingQuestion" maxlength="500" data-testid="wording-question" />
        </label>
        <label class="checkbox-label"><input type="checkbox" @bind="_includeBlockReasons" data-testid="wording-block-reasons" /> Also send the reasons steps could not be imported (addresses, paths and credential-looking values are removed, but they can still quote the source system, so you will always be asked first)</label>
        <button type="button" class="secondary-button" disabled="@(_busy || _wordingWorking)" @onclick="PrepareWordingAsync" data-testid="wording-start">Put the flow in plain words</button>
        @if (_wordingWorking) { <p class="field-hint" role="status">Working...</p> }
        @if (_wordingError is not null) { <p class="status-banner error" role="alert" data-testid="wording-error">@_wordingError</p> }
        @if (_wordingUnavailable is not null) { <p class="status-banner error" role="status" data-testid="wording-unavailable">AI help is not available: @_wordingUnavailable</p> }
        @if (_awaitingConsent && _wordingDisclosure is not null)
        {
            <div class="warning-panel" data-testid="wording-consent">
                <h4>Review before anything is sent</h4>
                <p>This will be sent to <strong>@_wordingDisclosure.Provider</strong> (model <strong>@_wordingDisclosure.Model</strong>). Nothing has been sent yet.</p>
                <ul>@foreach (var note in _wordingDisclosure.Notes) { <li>@note</li> }</ul>
                <pre class="assist-payload" data-testid="wording-payload">@_wordingDisclosure.Payload</pre>
                <div class="action-row">
                    <button class="run-button" disabled="@_wordingWorking" @onclick="() => SendWordingAsync(false)" data-testid="wording-send">Send</button>
                    @if (!_wordingDisclosure.IncludesBlockReasons)
                    {
                        <button class="secondary-button" disabled="@_wordingWorking" @onclick="() => SendWordingAsync(true)" data-testid="wording-send-remember">Send and don't ask again this session</button>
                    }
                    <button class="secondary-button" disabled="@_wordingWorking" @onclick="CancelWording" data-testid="wording-cancel">Cancel</button>
                </div>
                <p class="field-hint">"Don't ask again" lasts until you leave or reload this page. It is never saved. It is not offered when the reasons for blocked steps are included.</p>
            </div>
        }
        @if (_wordingReply is not null)
        {
            <div class="assist-reply" data-testid="wording-reply">
                <h4>AI-generated explanation</h4>
                <p class="field-hint">From @_wordingProvider (@_wordingModel). It may be wrong and it could not see any values. It has not been applied to anything.</p>
                <div class="assist-reply-text">@_wordingReply</div>
            </div>
        }
    </div>
    <h4>BizTalk terms</h4>
    <label class="field-label">Look up a term <input class="mapping-input" @bind="_search" maxlength="80" data-testid="glossary-search" /></label>
    <button type="button" class="secondary-button" disabled="@_busy" @onclick="SearchAsync" data-testid="glossary-go">Look up</button>
    @if (_terms is not null)
    {
        @if (_terms.Count == 0) { <p class="field-hint" data-testid="glossary-empty">No matching term.</p> }
        else
        {
            <dl data-testid="glossary-results">
                @foreach (var term in _terms) { <dt @key="term.Term">@term.Term</dt><dd>@term.Meaning <em>In Mulse: @term.InMulse</em></dd> }
            </dl>
        }
    }
</details>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? FlowId { get; set; }
    [Parameter] public BizTalkAssistConsent Consent { get; set; } = new();
    private string _wordingQuestion = "";
    private bool _includeBlockReasons, _wordingWorking, _awaitingConsent;
    private FlowWordingRequestViewModel? _wordingPending;
    private FlowWordingDisclosureViewModel? _wordingDisclosure;
    private string? _wordingError, _wordingUnavailable, _wordingReply, _wordingProvider, _wordingModel;
    private string _definition = "", _search = "";
    private string? _error;
    private bool _busy;
    private int _revision;
    private FlowExplanationViewModel? _flow;
    private NodeExplanationViewModel? _node;
    private IReadOnlyList<AssistGlossaryEntryViewModel>? _terms;
    private string? _promptModule;
    private string _moduleDescription = "";
    private ModulePromptViewModel? _prompt;

    protected override void OnParametersSet()
    {
        if (_definition == Value) return;
        _definition = Value;
        _revision++;
        _flow = null; _node = null; _error = null; _prompt = null; _promptModule = null;
        ResetWording();
    }

    // An approval or reply belongs to the exact flow it was prepared for, so it is dropped whenever the flow changes.
    private void ResetWording()
    {
        _wordingPending = null; _wordingDisclosure = null; _awaitingConsent = false;
        _wordingError = null; _wordingUnavailable = null; _wordingReply = null;
    }

    private async Task PrepareWordingAsync()
    {
        ResetWording();
        if (Services.GetService(typeof(IMulseApiClient)) is not IMulseApiClient api) { _wordingError = "The explanation API is unavailable."; return; }
        var revision = _revision;
        _wordingWorking = true;
        try
        {
            var question = string.IsNullOrWhiteSpace(_wordingQuestion) ? null : _wordingQuestion.Trim();
            var request = new FlowWordingRequestViewModel(Value, question, _includeBlockReasons, FlowId);
            var disclosure = await api.PreviewFlowWordingAsync(request, default);
            if (revision != _revision) return;
            _wordingDisclosure = disclosure;
            _wordingPending = request with { DisclosureSha256 = disclosure.PayloadSha256 };
            if (!disclosure.AiAvailable) { _wordingUnavailable = disclosure.Unavailable; return; }
            if (Consent.SkipMetadataPrompt && !disclosure.IncludesBlockReasons) { await SendWordingCoreAsync(api, revision); return; }
            _awaitingConsent = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or NotSupportedException)
        { if (revision == _revision) _wordingError = $"Unable to prepare the explanation: {exception.Message}"; }
        finally { _wordingWorking = false; }
    }

    private async Task SendWordingAsync(bool remember)
    {
        if (Services.GetService(typeof(IMulseApiClient)) is not IMulseApiClient api) return;
        _wordingWorking = true;
        try
        {
            if (remember && _wordingDisclosure is { IncludesBlockReasons: false }) Consent.SkipMetadataPrompt = true;
            await SendWordingCoreAsync(api, _revision);
        }
        finally { _wordingWorking = false; }
    }

    private async Task SendWordingCoreAsync(IMulseApiClient api, int revision)
    {
        if (_wordingPending is null) return;
        _awaitingConsent = false;
        try
        {
            var response = await api.FlowWordingAsync(_wordingPending, default);
            if (revision != _revision) return;
            _wordingReply = response.Reply; _wordingProvider = response.Provider; _wordingModel = response.Model;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or NotSupportedException)
        { if (revision == _revision) _wordingError = $"The AI request failed: {exception.Message}"; }
    }

    private void CancelWording()
    {
        _awaitingConsent = false; _wordingPending = null;
    }

    private async Task RunAsync(Func<IMulseApiClient, int, Task> action)
    {
        _error = null;
        if (Services.GetService(typeof(IMulseApiClient)) is not IMulseApiClient api) { _error = "The explanation API is unavailable."; return; }
        var revision = _revision;
        _busy = true;
        try { await action(api, revision); }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or NotSupportedException)
        { if (revision == _revision) _error = exception.Message; }
        finally { _busy = false; }
    }

    private Task ExplainFlowAsync() => RunAsync(async (api, revision) =>
    {
        var result = await api.ExplainNativeFlowAsync(Value, default);
        if (revision != _revision) return;
        _flow = result; _node = null;
    });

    private Task ExplainNodeAsync(string nodeId) => RunAsync(async (api, revision) =>
    {
        var result = await api.ExplainNativeNodeAsync(Value, nodeId, default);
        if (revision == _revision) _node = result;
    });

    private void ChooseModule(string module)
    {
        _promptModule = module; _prompt = null; _error = null;
    }

    private Task BuildPromptAsync() => RunAsync(async (api, revision) =>
    {
        if (_promptModule is not { } module) return;
        var result = await api.BuildModulePromptAsync(Value, module, string.IsNullOrWhiteSpace(_moduleDescription) ? null : _moduleDescription, default);
        if (revision == _revision && _promptModule == module) _prompt = result;
    });

    private Task SearchAsync() => RunAsync(async (api, _) => _terms = await api.SearchAssistGlossaryAsync(_search, default));
}
