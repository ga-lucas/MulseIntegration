@page "/"
@using System.Globalization
@inject IMulseApiClient ApiClient

<PageTitle>Dashboard | Mulse</PageTitle>

<div class="page-shell">
    <header class="page-hero">
        <div>
            <p class="eyebrow">Overview</p>
            <h1>Dashboard</h1>
            <p class="lede">How your integration flows are doing right now. Open <a href="/flows">Flows</a> to configure, enable or run them, or <a href="/history">History</a> for every run.</p>
        </div>
        <div class="home-actions">
            <a class="secondary-button" href="/flows">View flows</a>
            <a class="run-button" href="/designer">+ Create flow</a>
        </div>
    </header>

    <StatusBanner Error="@_errorMessage" />

    @if (_isLoading)
    {
        <p class="loading-state" role="status">Loading your dashboard...</p>
    }
    else if (_summary is not null)
    {
        var summary = _summary;
        <dl class="overview-grid" aria-label="Workspace summary">
            <div class="overview-stat"><dt>Flows</dt><dd>@summary.FlowCount</dd></div>
            <div class="overview-stat"><dt>Enabled</dt><dd>@summary.EnabledCount</dd></div>
            <div class="overview-stat"><dt>Disabled</dt><dd>@summary.DisabledCount</dd></div>
            <div class="overview-stat"><dt>Need setup</dt><dd>@summary.FlowsByHealth[FlowHealth.NeedsSetup]</dd></div>
            <div class="overview-stat"><dt>Modules</dt><dd>@summary.ModuleCount</dd></div>
            <div class="overview-stat"><dt>Success rate</dt><dd>@(summary.SuccessRate is { } rate ? Pct(rate) : "n/a")</dd></div>
        </dl>

        @if (summary.FlowCount == 0)
        {
            <p class="empty-state">No flows yet. <a href="/designer">Create a flow</a> or <a href="/biztalk-import">import one from BizTalk</a>.</p>
        }

        @if (!summary.HasRunData)
        {
            <p class="empty-state" role="status">Run history is not available, so run statistics are hidden. @_historyNote</p>
        }

        <section class="home-grid">
            <Panel Title="Flow health" Description="Each flow is counted once, by its most recent run and its setup.">
                <div class="home-donut-layout">
                    <div class="home-donut" role="img" aria-label="@HealthLabel(summary)" style="@DonutStyle(summary)">
                        <span class="home-donut-total">@summary.FlowCount<small>flows</small></span>
                    </div>
                    <ul class="home-legend">
                        @foreach (var health in HealthOrder)
                        {
                            var count = summary.FlowsByHealth[health];
                            if (count == 0 && health == FlowHealth.Other) { continue; }
                            <li><span class="home-swatch" style="background:@HealthColor(health)" aria-hidden="true"></span>@DashboardSummary.Describe(health) <strong>@count</strong></li>
                        }
                    </ul>
                </div>
            </Panel>

            @if (summary.HasRunData)
            {
                <Panel Title="Run outcomes" Description="@RunScope(summary)">
                    @if (summary.RunCount == 0)
                    {
                        <p class="empty-state">No runs recorded yet.</p>
                    }
                    else
                    {
                        <div class="home-bar" role="img" aria-label="@OutcomeLabel(summary)">
                            @foreach (var (label, count, color) in OutcomeSegments(summary))
                            {
                                if (count > 0)
                                {
                                    <span style="flex:@count;background:@color" title="@label: @count"></span>
                                }
                            }
                        </div>
                        <ul class="home-legend">
                            @foreach (var (label, count, color) in OutcomeSegments(summary))
                            {
                                <li><span class="home-swatch" style="background:@color" aria-hidden="true"></span>@label <strong>@count</strong></li>
                            }
                        </ul>
                    }
                </Panel>

                <Panel Title="Last 7 days" Description="Runs started per day (UTC), from the same window.">
                    @{
                        var max = Math.Max(1, summary.Last7Days.Max(day => day.Total));
                    }
                    <div class="home-columns" role="img" aria-label="@TrendLabel(summary)">
                        @foreach (var day in summary.Last7Days)
                        {
                            <div class="home-column">
                                <div class="home-column-bar" style="height:@Percent(day.Total, max)" title="@day.Date.ToString("MMM d", CultureInfo.InvariantCulture): @day.Completed completed, @day.Failed failed, @day.Other other">
                                    @if (day.Other > 0) { <span style="flex:@day.Other;background:var(--text-muted)"></span> }
                                    @if (day.Failed > 0) { <span style="flex:@day.Failed;background:var(--error-text)"></span> }
                                    @if (day.Completed > 0) { <span style="flex:@day.Completed;background:var(--success-text)"></span> }
                                </div>
                                <span class="home-column-label">@day.Date.ToString("ddd", CultureInfo.InvariantCulture)</span>
                                <span class="home-column-count">@day.Total</span>
                            </div>
                        }
                    </div>
                </Panel>
            }

            <Panel Title="Needs attention" Description="Failing, held or not yet set up.">
                @if (summary.Attention.Count == 0)
                {
                    <p class="empty-state">Nothing needs attention.</p>
                }
                else
                {
                    <ul class="home-list">
                        @foreach (var item in summary.Attention)
                        {
                            <li><a href="@item.Href">@item.DisplayName</a><span>@item.Reason</span></li>
                        }
                    </ul>
                    @if (summary.AttentionTotal > summary.Attention.Count)
                    {
                        <p class="home-more">and @(summary.AttentionTotal - summary.Attention.Count) more. <a href="/flows">See all flows</a>.</p>
                    }
                }
            </Panel>

            @if (summary.HasRunData)
            {
                <Panel Title="Failure patterns" Description="Recent failed, held and retrying runs grouped by likely cause. A starting point, not a diagnosis.">
                    @if (_patternsNote is not null)
                    {
                        <p class="empty-state" role="status">Failure patterns are not available. @_patternsNote</p>
                    }
                    else if (_patterns is null || _patterns.Patterns.Count == 0)
                    {
                        <p class="empty-state">No recent failed, held or retrying runs.</p>
                    }
                    else
                    {
                        @if (_patterns.Headline is not null)
                        {
                            <p class="home-headline">@_patterns.Headline</p>
                        }
                        <ul class="home-list">
                            @foreach (var pattern in _patterns.Patterns.Take(5))
                            {
                                <li>
                                    <span class="home-pattern-title"><strong>@pattern.Category</strong> at <code>@pattern.Stage</code></span>
                                    <span>@pattern.Runs run(s) (@Pct(pattern.Share)) in @pattern.FlowCount flow(s): @string.Join(", ", pattern.FlowIds)</span>
                                    <span>Check: @pattern.WhatToCheck</span>
                                    @if (pattern.FlowIds.Count > 0)
                                    {
                                        <a href="@("/history/" + Uri.EscapeDataString(pattern.FlowIds[0]))">See runs for @pattern.FlowIds[0]</a>
                                    }
                                </li>
                            }
                        </ul>
                        @if (_patterns.Patterns.Count > 5)
                        {
                            <p class="home-more">and @(_patterns.Patterns.Count - 5) more group(s).</p>
                        }
                        <p class="home-more">@string.Join(" ", _patterns.Notes)</p>
                    }
                </Panel>

                <Panel Title="Recent runs" Description="The latest executions across all flows.">
                    @if (summary.RecentRuns.Count == 0)
                    {
                        <p class="empty-state">No runs recorded yet.</p>
                    }
                    else
                    {
                        <ul class="home-list">
                            @foreach (var run in summary.RecentRuns)
                            {
                                <li>
                                    <a href="@("/history/" + Uri.EscapeDataString(run.FlowId))">@run.FlowId</a>
                                    <span><span class="status-pill @StateClass(run.State)">@run.State</span> @(run.StartedUtc is { } started ? started.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture) : "")</span>
                                </li>
                            }
                        </ul>
                    }
                </Panel>
            }
        </section>
    }
</div>

@code {
    private const int HistoryWindow = 200;
    private static readonly FlowHealth[] HealthOrder =
        [FlowHealth.Healthy, FlowHealth.Failing, FlowHealth.NeedsAttention, FlowHealth.NeedsSetup, FlowHealth.NotRunRecently, FlowHealth.Other];

    private DashboardSummary? _summary;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _historyNote;
    private FailurePatternReportViewModel? _patterns;
    private string? _patternsNote;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var flows = await ApiClient.GetFlowsAsync(CancellationToken.None);
            var modules = await ApiClient.GetModulesAsync(CancellationToken.None);
            var usages = await ApiClient.GetConfigValueUsagesAsync(CancellationToken.None);

            IReadOnlyList<HistoryExecutionViewModel>? executions = null;
            try
            {
                executions = await ApiClient.GetRecentExecutionsAsync(HistoryWindow, CancellationToken.None);
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                _historyNote = exception.Message;
            }

            _summary = DashboardSummary.Build(flows, modules, usages, executions, DateTime.UtcNow);

            if (_summary.HasRunData && _summary.Failed + _summary.Held + _summary.RunsByState.GetValueOrDefault("Retrying") > 0)
            {
                try
                {
                    _patterns = await ApiClient.GetFailurePatternsAsync(100, CancellationToken.None);
                }
                catch (Exception exception) when (exception is not OperationCanceledException)
                {
                    _patternsNote = exception.Message;
                }
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _errorMessage = $"Unable to load the dashboard: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string RunScope(DashboardSummary summary)
        => $"Based on the last {summary.RunCount} run(s) (up to {HistoryWindow}). Not an all-time figure.";

    private static string HealthColor(FlowHealth health) => health switch
    {
        FlowHealth.Healthy => "var(--success-text)",
        FlowHealth.Failing => "var(--error-text)",
        FlowHealth.NeedsAttention => "var(--warning-text)",
        FlowHealth.NeedsSetup => "var(--accent)",
        FlowHealth.NotRunRecently => "var(--text-muted)",
        _ => "var(--border-subtle)"
    };

    private static string DonutStyle(DashboardSummary summary)
    {
        if (summary.FlowCount == 0) { return "background:var(--border-subtle)"; }
        var stops = new List<string>();
        var start = 0d;
        foreach (var health in HealthOrder)
        {
            var count = summary.FlowsByHealth[health];
            if (count == 0) { continue; }
            var end = start + 100d * count / summary.FlowCount;
            stops.Add(FormattableString.Invariant($"{HealthColor(health)} {start:0.##}% {end:0.##}%"));
            start = end;
        }
        return "background:conic-gradient(" + string.Join(", ", stops) + ")";
    }

    private static string HealthLabel(DashboardSummary summary)
        => "Flow health: " + string.Join(", ", HealthOrder.Where(h => summary.FlowsByHealth[h] > 0).Select(h => $"{summary.FlowsByHealth[h]} {DashboardSummary.Describe(h).ToLowerInvariant()}"));

    private static (string Label, int Count, string Color)[] OutcomeSegments(DashboardSummary summary)
    {
        var other = summary.RunCount - summary.Completed - summary.Failed - summary.InProgress - summary.Held;
        return
        [
            ("Completed", summary.Completed, "var(--success-text)"),
            ("Failed", summary.Failed, "var(--error-text)"),
            ("In progress", summary.InProgress, "var(--accent)"),
            ("Held", summary.Held, "var(--warning-text)"),
            ("Other", other, "var(--text-muted)")
        ];
    }

    private static string OutcomeLabel(DashboardSummary summary)
        => "Run outcomes: " + string.Join(", ", OutcomeSegments(summary).Where(s => s.Count > 0).Select(s => $"{s.Count} {s.Label.ToLowerInvariant()}"));

    private static string TrendLabel(DashboardSummary summary)
        => "Runs per day: " + string.Join(", ", summary.Last7Days.Select(d => $"{d.Date.ToString("MMM d", CultureInfo.InvariantCulture)} {d.Total}"));

    private static string Pct(double fraction)
        => Math.Round(fraction * 100, MidpointRounding.AwayFromZero).ToString("0", CultureInfo.InvariantCulture) + "%";

    private static string Percent(int value, int max)
        => value == 0 ? "2px" : (100d * value / max).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string StateClass(string state) => state switch
    {
        "Completed" => "enabled",
        "Failed" or "Held" or "Retrying" => "warning",
        _ => string.Empty
    };
}
